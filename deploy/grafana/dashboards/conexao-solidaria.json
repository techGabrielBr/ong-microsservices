{
  "uid": "conexao-solidaria",
  "title": "Conexao Solidaria - Plataforma",
  "tags": [
    "ong",
    "microsservicos",
    "hackathon"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Doacoes recebidas x processadas (acumulado)",
      "type": "timeseries",
      "description": "Prova o fluxo assincrono: a API publica o evento e o Worker consolida depois.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "conexao_solidaria_doacoes_recebidas_total{job=\"conexao-solidaria-api\"}",
          "legendFormat": "recebidas pela API",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        },
        {
          "expr": "conexao_solidaria_doacoes_processadas_total{job=\"conexao-solidaria-worker\"}",
          "legendFormat": "consolidadas pelo Worker",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        },
        {
          "expr": "conexao_solidaria_doacoes_rejeitadas_total{job=\"conexao-solidaria-api\"}",
          "legendFormat": "rejeitadas - {{motivo}}",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "Valor total consolidado pelo Worker",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "conexao_solidaria_valor_arrecadado_total{job=\"conexao-solidaria-worker\"}",
          "legendFormat": "R$ consolidado",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Backlog (recebidas - processadas)",
      "type": "stat",
      "description": "Diferenca entre o que entrou na fila e o que ja foi consolidado.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(conexao_solidaria_doacoes_recebidas_total{job=\"conexao-solidaria-api\"}) - sum(conexao_solidaria_doacoes_processadas_total{job=\"conexao-solidaria-worker\"})",
          "legendFormat": "mensagens em transito",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Throughput de doacoes (por minuto)",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(conexao_solidaria_doacoes_recebidas_total{job=\"conexao-solidaria-api\"}[1m]) * 60",
          "legendFormat": "recebidas/min",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        },
        {
          "expr": "rate(conexao_solidaria_doacoes_processadas_total{job=\"conexao-solidaria-worker\"}[1m]) * 60",
          "legendFormat": "processadas/min",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Latencia de processamento no Worker (p50 / p95)",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(conexao_solidaria_doacao_processamento_segundos_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(conexao_solidaria_doacao_processamento_segundos_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
