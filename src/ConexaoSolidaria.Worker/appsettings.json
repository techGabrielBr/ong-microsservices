{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=conexaosolidaria;Username=postgres;Password=postgres"
  },
  "Messaging": {
    "Provider": "RabbitMq",
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5672,
      "Usuario": "guest",
      "Senha": "guest",
      "VirtualHost": "/",
      "PrefetchCount": 10
    },
    "Aws": {
      "TopicName": "doacoes-recebidas",
      "QueueName": "doacoes-recebidas",
      "DeadLetterQueueName": "doacoes-recebidas-dlq",
      "MaxNumberOfMessages": 10,
      "WaitTimeSeconds": 10
    }
  },
  "Aws": {
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test",
    "ServiceUrl": "http://localhost:4566",
    "TabelaDoacoes": "doacoes"
  }
}